{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BGCC7 Helper",
  "version": "1.0.0",
  "identifier": "net.bgcc.ref",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BGCC7 Helper",
        "width": 560,
        "height": 820,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "center": true,
        "visible": false,
        "backgroundColor": "#fdfcfb"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://a.ppy.sh"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  },
  "mainBinaryName": "BGCC7 Helper"
}
